# Copy to .env.local for local work; set the same names in Vercel -> Settings -> Environment Variables.

# Supabase (Project Settings -> API Keys). Both values are public by design:
# the publishable key is safe in a browser because every table is protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The site's own address, used for the sitemap and share cards (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional: a long random string. When set, the daily keep-alive request (vercel.json -> /api/keepalive) must send it,
# which Vercel Cron does automatically.
CRON_SECRET=
